          {
            "type": "choice",
            "name": "text_color",
            "label": "Text color",
            "display": "select",
            "choices": [
              [
                "auto",
                "Auto"
              ],
              [
                "dark",
                "Dark"
              ],
              [
                "light",
                "Light"
              ]
            ],
            "default": "auto",
            "help_text": "Auto picks light or dark text from the picked colors: the background color, the overlay color for images (with their opacity), or both gradient colors. It chooses the text color with the higher contrast. Gradient: light text only when both colors are dark; for a gradient that mixes a light and a dark color, Auto gives dark text, so set Dark or Light manually."
          }
        ]
