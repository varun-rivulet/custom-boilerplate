            "default": "right",
            "visibility_rules": "ADVANCED",
            "advanced_visibility": {
              "boolean_operator": "AND",
              "criteria": [
                {
                  "controlling_field_path": "style.background.type",
                  "operator": "MATCHES_REGEX",
                  "controlling_value_regex": "^gradient$"
                }
