  {
    "type": "group",
    "name": "style",
    "label": "Style",
    "expanded": false,
    "children": [
      {
        "type": "group",
        "name": "background",
        "label": "Background",
        "expanded": true,
        "children": [
          {
            "type": "choice",
            "name": "type",
            "label": "Background type",
            "display": "select",
            "placeholder": "No background",
            "choices": [
              [
                "color",
                "Color"
              ],
              [
                "image",
                "Image"
              ],
              [
                "gradient",
                "Gradient"
              ]
            ],
            "help_text": "Leave empty for no background."
          },
          {
            "type": "color",
            "name": "color",
            "label": "Background color",
            "show_opacity": true,
            "inherited_value": {
              "property_value_paths": {
                "color": "theme.colors.dark_bg.color",
                "opacity": "theme.colors.dark_bg.opacity"
              }
            },
            "default": {
              "color": null,
              "opacity": null
            },
            "help_text": "Defaults to the theme's Dark background color (Theme settings > Colors) until you pick another color.",
            "visibility_rules": "ADVANCED",
            "advanced_visibility": {
              "boolean_operator": "AND",
              "criteria": [
                {
                  "controlling_field_path": "style.background.type",
                  "operator": "MATCHES_REGEX",
                  "controlling_value_regex": "^color$"
                }
              ]
            }
          },
          {
            "type": "image",
            "name": "image",
            "label": "Background image",
            "resizable": false,
