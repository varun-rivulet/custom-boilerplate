            "primary",
            "Primary"
          ],
          [
            "secondary",
            "Secondary"
          ],
          [
            "primary-outline",
            "Primary outline"
          ],
          [
            "secondary-outline",
            "Secondary outline"
          ],
          [
            "text-link",
            "Text link"
          ]
        ],
        "default": "primary"
