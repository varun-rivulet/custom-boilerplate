                  ]
                },
                "left": {
                  "min": 0,
                  "max": 400,
                  "units": [
                    "px"
                  ]
                }
              }
            },
            "default": {
              "padding": {
                "top": {
                  "value": 100,
                  "units": "px"
                },
                "bottom": {
                  "value": 100,
                  "units": "px"
                }
              }
            },
            "help_text": "All four sides apply from this breakpoint down. A side left empty keeps the value from the larger breakpoint (on Desktop: no padding).",
            "visibility_rules": "ADVANCED",
            "advanced_visibility": {
              "boolean_operator": "AND",
