      {
        "type": "group",
        "name": "spacing",
        "label": "Spacing",
        "expanded": false,
        "children": [
          {
            "type": "boolean",
            "name": "change_spacing",
            "label": "Change spacing",
            "display": "toggle",
            "default": false,
            "help_text": "Off: the theme's default section padding (Theme settings > Spacing > Section padding, Medium). On: custom padding per breakpoint."
          },
          {
            "type": "spacing",
            "name": "desktop",
            "label": "Desktop & ≤1366.98px",
            "visibility": {
              "hidden_subfields": {
                "margin": true
              }
            },
            "limits": {
              "padding": {
                "top": {
                  "min": 0,
                  "max": 400,
                  "units": [
                    "px"
                  ]
                },
